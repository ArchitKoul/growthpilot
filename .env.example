# GrowthPilot environment variables. Copy to .env.local — never commit real values.
# All are read on the server only.

# Live AI investigations (optional). Without it the app runs in free demo mode.
ANTHROPIC_API_KEY=
# Optional model override. Default: claude-opus-5-5
ANTHROPIC_MODEL=

# Optional persistence of investigation results (run supabase/schema.sql first).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
